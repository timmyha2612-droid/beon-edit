{
	Tools = ordered() {
		BeonNameTitle = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				NameText = InstanceInput { SourceOp = "Name", Source = "StyledText", Name = "Name", Page = "Controls" },
				RoleText = InstanceInput { SourceOp = "Role", Source = "StyledText", Name = "Role", Page = "Controls" },
				Position = InstanceInput { SourceOp = "Name", Source = "Center", Name = "Position" },
				Justify = InstanceInput { SourceOp = "Name", Source = "HorizontalLeftCenterRight", Name = "Justify", Default = -1 },
				NameFont = InstanceInput { SourceOp = "Name", Source = "Font", Name = "Name Font", ControlGroup = 2 },
				NameStyle = InstanceInput { SourceOp = "Name", Source = "Style", ControlGroup = 2 },
				NameSize = InstanceInput { SourceOp = "Name", Source = "Size", Name = "Name Size", Default = 0.11 },
				RoleFont = InstanceInput { SourceOp = "Role", Source = "Font", Name = "Role Font", ControlGroup = 3 },
				RoleStyle = InstanceInput { SourceOp = "Role", Source = "Style", ControlGroup = 3 },
				RoleSize = InstanceInput { SourceOp = "Role", Source = "Size", Name = "Role Size", Default = 0.026 },
				RoleTracking = InstanceInput { SourceOp = "Role", Source = "CharacterSpacing", Name = "Role Tracking", Default = 1.18 },
				RoleOpacity = InstanceInput { SourceOp = "Role", Source = "Alpha1", Name = "Role Opacity", Default = 0.85 },
				InDur = InstanceInput { SourceOp = "Ctl", Source = "InDur", Default = 10 },
				Stagger = InstanceInput { SourceOp = "Ctl", Source = "Stagger", Default = 6 },
				Rise = InstanceInput { SourceOp = "Ctl", Source = "Rise", Default = 0.012 },
				InBlur = InstanceInput { SourceOp = "Ctl", Source = "InBlur", Default = 8 },
				OutDur = InstanceInput { SourceOp = "Ctl", Source = "OutDur", Default = 10 },
				OutLift = InstanceInput { SourceOp = "Ctl", Source = "OutLift", Default = 0.01 },
				OutBlur = InstanceInput { SourceOp = "Ctl", Source = "OutBlur", Default = 10 },
				Gap = InstanceInput { SourceOp = "Ctl", Source = "Gap", Default = 0.085 },
				ShadowAlpha = InstanceInput { SourceOp = "Ctl", Source = "ShadowAlpha", Default = 0 },
				ShadowSoft = InstanceInput { SourceOp = "Ctl", Source = "ShadowSoft", Default = 6 },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "OutMerge", Source = "Output" },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Name = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						StyledText = Input { Value = "Bonnie", },
						Font = Input { Value = "Garet", },
						Style = Input { Value = "Book", },
						Size = Input { Value = 0.11, },
						CharacterSpacing = Input { Value = 0.98, },
						LineSpacing = Input { Value = 0.95, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Enabled3 = Input { Value = 0, Expression = "Ctl.ShadowAlpha > 0 and 1 or 0", },
						Size3 = Input { Value = 1, },
						SizeX3 = Input { Value = 1, },
						SizeY3 = Input { Value = 1, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.5, Expression = "Ctl.ShadowAlpha", },
						Offset3 = Input { Value = { 0.004, -0.012 }, },
						SoftnessX3 = Input { Value = 6, Expression = "Ctl.ShadowSoft", },
						SoftnessY3 = Input { Value = 6, Expression = "Ctl.ShadowSoft", },
						Center = Input { Value = { 0.68, 0.6 }, },
						HorizontalLeftCenterRight = Input { Value = -1, },
						ManualFontKerningPlacement = Input {
							Value = StyledText { Array = { }, Value = "" },
						},
					},
				},
				Role = TextPlus {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						StyledText = Input { Value = "FOUNDER & CEO", },
						Font = Input { Value = "Garet", },
						Style = Input { Value = "Book", },
						Size = Input { Value = 0.026, },
						CharacterSpacing = Input { Value = 1.18, },
						LineSpacing = Input { Value = 0.95, },
						VerticalJustificationNew = Input { Value = 3, },
						HorizontalJustificationNew = Input { Value = 3, },
						Enabled3 = Input { Value = 0, Expression = "Ctl.ShadowAlpha > 0 and 1 or 0", },
						Size3 = Input { Value = 1, },
						SizeX3 = Input { Value = 1, },
						SizeY3 = Input { Value = 1, },
						Red3 = Input { Value = 0, },
						Green3 = Input { Value = 0, },
						Blue3 = Input { Value = 0, },
						Alpha3 = Input { Value = 0.5, Expression = "Ctl.ShadowAlpha", },
						Offset3 = Input { Value = { 0.004, -0.012 }, },
						SoftnessX3 = Input { Value = 6, Expression = "Ctl.ShadowSoft", },
						SoftnessY3 = Input { Value = 6, Expression = "Ctl.ShadowSoft", },
						Center = Input { Value = { 0.68, 0.52 }, Expression = "Point(Name.Center.X, Name.Center.Y-Ctl.Gap)", },
						HorizontalLeftCenterRight = Input { Value = -1, Expression = "Name.HorizontalLeftCenterRight", },
						Alpha1 = Input { Value = 0.85, },
						ManualFontKerningPlacement = Input {
							Value = StyledText { Array = { }, Value = "" },
						},
					},
				},
				NameFx = Expression {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						n1 = Input { Value = 0, Expression = "1-(1-min(max((time-0)/max(Ctl.InDur,1),0),1))^3", },
						n2 = Input { Value = 0.012, Expression = "Ctl.Rise", },
						NumberExpression = Input { Value = "n1", },
						PointExpressionX = Input { Value = "0.5", },
						PointExpressionY = Input { Value = "0.5-n2*(1-n1)", },
					},
				},
				NameBlur = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "max(0, Ctl.InBlur*(1-NameMerge.Blend))", },
						Input = Input { SourceOp = "Name", Source = "Output", },
					},
				},
				NameMerge = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Clear", Source = "Output", },
						Foreground = Input { SourceOp = "NameBlur", Source = "Output", },
						Center = Input { SourceOp = "NameFx", Source = "PointResult", },
						Blend = Input { SourceOp = "NameFx", Source = "NumberResult", },
						PerformDepthMerge = Input { Value = 0, },
					},
				},
				RoleFx = Expression {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						n1 = Input { Value = 0, Expression = "1-(1-min(max((time-Ctl.Stagger)/max(Ctl.InDur,1),0),1))^3", },
						n2 = Input { Value = 0.012, Expression = "Ctl.Rise", },
						NumberExpression = Input { Value = "n1", },
						PointExpressionX = Input { Value = "0.5", },
						PointExpressionY = Input { Value = "0.5-n2*(1-n1)", },
					},
				},
				RoleBlur = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "max(0, Ctl.InBlur*(1-RoleMerge.Blend))", },
						Input = Input { SourceOp = "Role", Source = "Output", },
					},
				},
				RoleMerge = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "NameMerge", Source = "Output", },
						Foreground = Input { SourceOp = "RoleBlur", Source = "Output", },
						Center = Input { SourceOp = "RoleFx", Source = "PointResult", },
						Blend = Input { SourceOp = "RoleFx", Source = "NumberResult", },
						PerformDepthMerge = Input { Value = 0, },
					},
				},
				Ctl = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Width = Input { Value = 16, },
						Height = Input { Value = 16, },
						InDur = Input { Value = 10, },
						Stagger = Input { Value = 6, },
						Rise = Input { Value = 0.012, },
						InBlur = Input { Value = 8, },
						OutDur = Input { Value = 10, },
						OutLift = Input { Value = 0.01, },
						OutBlur = Input { Value = 10, },
						Gap = Input { Value = 0.085, },
						ShadowAlpha = Input { Value = 0, },
						ShadowSoft = Input { Value = 6, },
					},
					UserControls = ordered() {
						InDur = { LINKS_Name = "In Duration (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 10, INP_MinScale = 1, INP_MaxScale = 40, INP_MinAllowed = 1, ICS_ControlPage = "Controls" },
						Stagger = { LINKS_Name = "Role Delay (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 6, INP_MinScale = 0, INP_MaxScale = 30, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						Rise = { LINKS_Name = "Rise Distance", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.012, INP_MinScale = 0, INP_MaxScale = 0.1, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						InBlur = { LINKS_Name = "In Blur", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 8, INP_MinScale = 0, INP_MaxScale = 40, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						OutDur = { LINKS_Name = "Out Duration (frames)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 10, INP_MinScale = 0, INP_MaxScale = 40, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						OutLift = { LINKS_Name = "Out Lift", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.01, INP_MinScale = 0, INP_MaxScale = 0.1, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						OutBlur = { LINKS_Name = "Out Blur", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 10, INP_MinScale = 0, INP_MaxScale = 40, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						Gap = { LINKS_Name = "Line Gap", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0.085, INP_MinScale = 0, INP_MaxScale = 0.3, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						ShadowAlpha = { LINKS_Name = "Shadow Opacity (0 = off)", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 0, INP_MinScale = 0, INP_MaxScale = 1, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
						ShadowSoft = { LINKS_Name = "Shadow Softness", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", INP_Default = 6, INP_MinScale = 0, INP_MaxScale = 20, INP_MinAllowed = 0, ICS_ControlPage = "Controls" },
					},
				},
				OutCurveLookup = LUTBezier {
					KeyColorSplines = {
						[0] = {
							[0] = { 0, RH = { 0.4, 0 } },
							[1] = { 1, LH = { 1, 1 } }
						}
					},
					SplineColor = { Red = 255, Green = 255, Blue = 255 },
				},
				OutCurve = LUTLookup {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Source = Input { Value = FuID { "Custom" }, },
						Input = Input { Value = 0, Expression = "min(max((time-(comp.RenderEnd+1-Ctl.OutDur))/max(Ctl.OutDur,1),0),1)", },
						Curve = Input { Value = FuID { "Custom" }, },
						EaseIn = Input { Value = FuID { "Sine" }, },
						EaseOut = Input { Value = FuID { "Sine" }, },
						Lookup = Input { SourceOp = "OutCurveLookup", Source = "Value", },
					},
				},
				OutFx = Expression {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						n1 = Input { SourceOp = "OutCurve", Source = "Value", },
						n2 = Input { Value = 0.015, Expression = "Ctl.OutLift", },
						NumberExpression = Input { Value = "1-min(max(n1,0),1)", },
						PointExpressionX = Input { Value = "0.5", },
						PointExpressionY = Input { Value = "0.5+n2*n1", },
					},
				},
				OutBlurTool = Blur {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Filter = Input { Value = FuID { "Gaussian" }, },
						XBlurSize = Input { Value = 0, Expression = "max(0, Ctl.OutBlur*(1-OutMerge.Blend))", },
						Input = Input { SourceOp = "RoleMerge", Source = "Output", },
					},
				},
				Clear = Background {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						GlobalOut = Input { Value = 20000, },
						Width = Input { Value = 1920, },
						Height = Input { Value = 1080, },
						UseFrameFormatSettings = Input { Value = 1, },
						["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
						TopLeftAlpha = Input { Value = 0, },
					},
				},
				OutMerge = Merge {
					CtrlWZoom = false,
					NameSet = true,
					Inputs = {
						Background = Input { SourceOp = "Clear", Source = "Output", },
						Foreground = Input { SourceOp = "OutBlurTool", Source = "Output", },
						Center = Input { SourceOp = "OutFx", Source = "PointResult", },
						Blend = Input { SourceOp = "OutFx", Source = "NumberResult", },
						PerformDepthMerge = Input { Value = 0, },
					},
				},
			},
		},
	},
	ActiveTool = "BeonNameTitle",
}
